# pdfexsvr environment variables
#
# Copy to .env (gitignored) and fill in, or set them as container env vars
# in Docker/Coolify. See "Environment variables" in README.md.
#
#   cp .env.example .env
#
# `pnpm dev` loads .env via --env-file-if-exists, so a value already exported
# in your shell (e.g. by pnpm dev:local) always wins over this file.

# PocketBase server URL. Defaults to https://pb-pdfex-dev.eemerg.dev/ when unset.
DBURL=

# PocketBase superuser email (the `_superusers` auth collection).
# Used by authSuperuser() in src/lib/db/pb.ts.
DBUSER=

# PocketBase superuser password.
DBPASSWD=

# ---------------------------------------------------------------------------
# Logging - all optional, all commented out so the defaults apply.
# See "Logging" in README.md. Values are read once at startup.
# ---------------------------------------------------------------------------

# error | warn | info | debug | silent   (default: debug - log everything)
#LOG_LEVEL=debug

# json | pretty   (default: pretty on a terminal, json otherwise)
#LOG_FORMAT=json

# Capture request/response payloads (default: 1)
#LOG_BODIES=1

# 1 = write RAW credentials (API keys, passwords, tokens) to the logs.
# Default 0 = credentials are fingerprinted instead:
#   apikey="<redacted prefix=dev*** len=15 sha=0e32c8eb>"
# Turn this on only for a debugging session, and never on a shared log store.
#LOG_SECRETS=0

# Truncation / depth limits (defaults shown)
#LOG_MAX_STRING=8000
#LOG_MAX_ARRAY=50
#LOG_MAX_BODY=1000000
#LOG_DEPTH=8

# Colourise pretty output (default: only when stdout is a terminal)
#LOG_COLORS=1

# Service name attached to every line (default: pdfexsvr)
#LOG_SERVICE=pdfexsvr
